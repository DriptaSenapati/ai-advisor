model FinalTransactionData {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  userId              String
  date                DateTime
  description         String
  creditAmount        Float
  debitAmount         Float
  balance             Float
  clusterId           String?            @db.ObjectId
  cluster             Cluster?           @relation(fields: [clusterId], references: [id])
  descriptionVector   Float[]
  statementMetadataId String?            @db.ObjectId
  statementMetadata   StatementMetadata? @relation(fields: [statementMetadataId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, date])
}

model Cluster {
  id                       String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String
  transactions             FinalTransactionData[]
  clusterLength            Int
  bankName                 String?
  merchantName             String?
  payeeName                String?
  category                 String?
  confidence               Float?
  categorySupportRationale String?
  centroid                 String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([userId, bankName])
}

/// One spelling of a payee that was folded into another.
///
/// Provenance for `payeeCanonicalizerTool`, which rewrites `Cluster.payeeName` in place — so
/// without this the old spelling is simply gone and the UI can only assert that a name is
/// correct. A merge is a judgement call made by an algorithm about somebody's money, and the
/// reader is owed the working: which spellings were folded in, and how much each carried.
///
/// Written at merge time and **never deleted by a later run**. That is load-bearing rather
/// than lazy: once `SENAPATI D` has been rewritten it no longer exists on any cluster, so the
/// next run sees nothing to merge and would drop the record if it recomputed the table from
/// current state.
model PayeeAlias {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  /// The spelling that survived — matches `Cluster.payeeName`.
  canonical String
  /// The spelling that was folded in.
  alias     String
  /// Transactions that carried the alias, for the popup's per-spelling count.
  txnCount  Int      @default(0)
  mergedAt  DateTime @default(now())

  @@unique([userId, alias])
  @@index([userId, canonical])
}

model MonthlyStats {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  month             String
  totalIncome       Float
  totalExpenses     Float
  netSavings        Float
  savingsRate       Float
  closingBalance    Float
  totalRefunds      Float
  refundCount       Int
  categoryBreakdown Json[]
  topMerchants      Json[]
  weekdayVsWeekend  Json
  timeOfMonth       Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // `month` alone was never unique, so the upsert was emulated with
  // findFirst + update. Scoped by user it is a real key, and a real upsert.
  @@unique([userId, month])
}

model RecurringPattern {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String
  type                   String?   @default("debit") // "debit" | "credit"
  merchantName           String?
  payeeName              String?
  category               String?
  estimatedMonthlyAmount Float
  rangeMin               Float?    // credit only: Q1 - 0.5*IQR of monthly amounts
  rangeMax               Float?    // credit only: Q3 + 0.5*IQR of monthly amounts
  creditLabel            String?   // "salary" | "freelance" | "rental_income" | "investment_return" | "transfer_in" | "unknown"
  clusterKey             String?   // unnamed credit clusters: clusterId hex string
  frequency              String
  monthsDetected         Int
  cancellability         String?   // "cancellable" | "pausable" | "obligation" | "essential"
  isActive               Boolean
  lastTransactionDate    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Without `userId` in this key, two users whose salary happens to be the same
  // amount collide on a single row — one overwrites the other's pattern.
  @@unique([userId, merchantName, payeeName, estimatedMonthlyAmount, type])
}

/// One flagged transaction (or one flagged pattern, for the two kinds that have no single
/// transaction behind them). Written by `red_flag_detector_tool.ts` — every detector is a
/// deterministic Mongo aggregation, so each row carries a real amount, date and id and can
/// be sorted, filtered and linked. The LLM only narrates the *kinds*, never the rows.
///
/// Deliberately NOT a field on `FinalTransactionData`: one transaction can trip several
/// detectors, thresholds move as more months arrive, and re-running detection must not
/// rewrite the transaction ledger.
model TransactionFlag {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String
  // Deterministic identity: "<kind>:<transactionId|label>:<month>". The insights
  // pipeline re-runs on every statement upload, so a create-only detector would
  // multiply flags on each pass; this key makes the write idempotent.
  dedupeKey String
  kind     String // duplicate_charge | merchant_outlier | category_spike_contributor
  //                | fee_or_interest | subscription_price_hike | balance_risk
  //                | large_opaque_transfer
  severity String // "high" | "medium" | "low"
  month    String // "YYYY-MM"

  // Null for the two pattern-level kinds (subscription_price_hike has no single txn).
  transactionId String?   @db.ObjectId
  clusterId     String?   @db.ObjectId
  label         String // merchant / payee / centroid, snapshotted at detection time
  category      String?
  amount        Float
  occurredAt    DateTime?

  title      String
  detail     String
  evidence   Json? // kind-specific: {count,dates[]} | {median,ratio} | {oldAmount,newAmount} | …
  detectedAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, severity])
  @@index([userId, month])
}

model InsightReport {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  // Required, not optional. As `String?` this was declared, filtered on every
  // read, and never once written — so `/insights/*` 404'd for every user and
  // nothing complained. A required field turns that into a write-time error.
  userId           String
  generatedAt      DateTime @default(now())
  monthsCovered    String[]
  tier             Int
  insights         Json
  rawStatsSnapshot Json
  chartData        Json?
  /// 0–100, deterministic — see `modules/insights/health_score.ts`. Optional
  /// because reports generated before it existed have none, and a missing score
  /// must render as "no score yet" rather than as zero.
  healthScore      Int?
  /// The same score with the plan's total bounded monthly impact applied, so the
  /// overview can say "15 → 43 after completing the plan". Counterfactual over the
  /// months on record, not a forecast — `recoveryProjection` owns the future.
  healthScoreAfterPlan Int?
  /// low | medium | high, banded off `healthScore` alone so the two cannot disagree.
  riskLevel        String?
  /// Against the previous report for this user. Null on the first one — there is
  /// nothing to compare with, which is not the same fact as "no change".
  scoreDelta       Int?
  /// The four weighted drivers behind `healthScore` — each with its contribution,
  /// the figure it was measured from, a plain-English explanation, a per-driver
  /// trend and one costed suggestion. Persisted so the number can be explained
  /// without recomputing it, and so the *next* report can diff against it.
  scoreBreakdown   Json?
  /// The same four drivers, recomputed with the plan's bounded uplift applied —
  /// `scoreAfterPlan()` already builds this full breakdown (not just the total),
  /// it was simply being discarded. Only `savings` and `cash_flow` actually move
  /// under today's formula, since the uplift is applied to `netSavings` alone;
  /// `money_at_risk` and `committed_spending` come back identical to
  /// `scoreBreakdown`. Null wherever `healthScoreAfterPlan` is null.
  scoreBreakdownAfterPlan Json?
  createdAt        DateTime @default(now())
}

model Goal {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String
  /// What the user actually typed — "buy a laptop". Optional because goals created
  /// straight through the API predate the composer and never had one.
  title            String?
  goalType         String
  targetAmount     Float
  deadline         DateTime
  categoryTarget   String?
  /// active | checking | completed | cancelled. "checking" is the window between the
  /// composer submitting and the intent gate ruling on it.
  status           String   @default("active")
  simulationResult Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, status])
}

model StatementExtractedData {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  statementMetadataId String            @unique @db.ObjectId
  statementMetadata   StatementMetadata @relation(fields: [statementMetadataId], references: [id])
  rows                Json[]
  createdAt           DateTime          @default(now())
}

model ErrorPdfExtract {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  action              String
  rationale           String
  row                 Json
  statementMetadataId String?            @db.ObjectId
  statementMetadata   StatementMetadata? @relation("ErrorPdfExtractMetadata", fields: [statementMetadataId], references: [id])
  createdAt           DateTime           @default(now())
}

// Better Auth models — use plain string IDs (Better Auth generates its own non-ObjectId IDs)
model User {
  id            String    @id @map("_id")
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

/// Which subscription plan a user is on.
///
/// **Deliberately its own model rather than a field on `User`.** That row is
/// owned by better-auth's Prisma adapter, which creates it during signup from a
/// fixed shape; a required field added there is a signup failure waiting to
/// happen. Following the convention every domain model here already uses,
/// `userId` is a plain `String` with no FK relation — the better-auth models use
/// non-ObjectId string ids.
///
/// **No row means the free plan.** `resolvePlan()` in `src/config/plans.ts`
/// treats absent and unrecognised identically, which is what lets this ship
/// without a backfill over existing users, and what makes a plan id retired from
/// the catalog degrade to free rather than 500 every request that user makes.
///
/// `status`, `endsAt` and `source` carry no logic today — nothing writes anything
/// but `active`/`manual`. They exist because the shape of a subscription is
/// well known and adding them later would mean touching every read; a payment
/// provider's ids belong beside them when one is wired up.
model Subscription {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @unique
  plan      String // PlanId — "first" | "glow" | "radiant"
  status    String    @default("active") // active | cancelled
  source    String    @default("manual") // manual | dev | <provider>
  startedAt DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Every answer a user has given at the Illuminate gate, append-only.
///
/// Deliberately NOT cascaded by `deleteStatement` — an audit log a delete erases
/// is not an audit log. That is also why the relation is optional and why
/// `bankName`/`rawRowCount` are copied in rather than read through: the row has
/// to stay meaningful after the statement it describes is gone.
///
/// One statement can have several rows. Declining and later approving is a
/// supported path, and both answers are kept in order; `StatementMetadata.gateDecision`
/// holds only the latest.
model StatementGateDecision {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  statementMetadataId String?            @db.ObjectId
  statementMetadata   StatementMetadata? @relation(fields: [statementMetadataId], references: [id])
  userId              String
  decision            String // "approved" | "declined" | "discarded"
  reason              String?
  bankName            String?
  rawRowCount         Int?
  decidedAt           DateTime           @default(now())
  createdAt           DateTime           @default(now())
}

/// Durable job-level history for the admin panel. Bull Board/Redis only holds
/// job state ephemerally — this is the only persisted record that a job ran at
/// all. One row per BullMQ *attempt* (job.id is reused across retries), written
/// at enqueue time and updated by the worker's completed/failed handlers.
model AdminJobLog {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  jobType             String // "pdf.extract" | "pdf.process" | "insights.generate" | "goal.analyze"
  jobId               String // BullMQ job.id — correlates back to Bull Board
  userId              String?
  statementMetadataId String?   @db.ObjectId
  status              String // "started" | "completed" | "failed"
  triggerSource       String // "user-upload" | "user-action" | "auto-chain" | "system-requeue"
  startedAt           DateTime
  finishedAt          DateTime?
  error               String?
  createdAt           DateTime  @default(now())

  @@index([jobType, status])
  @@index([userId])
  @@index([statementMetadataId])
}

/// Curated marketing copy, admin-editable, publicly readable via GET /content.
/// A fixed key vocabulary, not a generic CMS. A missing row for a key means
/// "render the component's own hardcoded default" — the marketing site cannot
/// break because this collection is empty.
model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "hero.headline" | "hero.subhead" | "hero.cta" | "nav.features" |
  /// "nav.howItWorks" | "nav.security" | "nav.pricing" | "footer.blurb" |
  /// "cta.heading" | "cta.body" | "cta.buttonLabel"
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String // "admin" — audit trail only, not access control
}

/// Marketing testimonials, admin-editable, publicly readable via GET
/// /testimonials. A list rather than a SiteContent key/value, since each
/// entry is a small structured record, not a single string.
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  role      String
  initials  String
  /// One of the six CSS variables already re-pointed for dark mode that the
  /// default testimonials use — see the picker in the admin form.
  bg        String
  /// Display order, ascending. Ties broken by createdAt.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model StatementMetadata {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String?
  /// The name of the PDF as the user uploaded it, sanitised for display only.
  /// The file on disk is a UUID and is deleted when phase 1 ends, so this is the
  /// only thing tying a row back to the file someone chose — and it is frozen at
  /// upload, so renaming the PDF afterwards changes nothing here. Never a path:
  /// see `displayFileName` in statements.service.ts. Nullable for rows uploaded
  /// before it existed.
  fileName               String?
  /// The upload's basename in `uploads/`, kept ONLY while a statement is waiting
  /// on a PDF password — the one failure the user can fix, and the one case where
  /// deleting the file would force a re-upload to supply it. Cleared (and the file
  /// removed) when extraction succeeds or the statement is deleted. Never returned
  /// by the API: see `publicStatement` in statements.service.ts.
  retainedFile           String?
  bankName               String
  accountNumber          String?
  statementPeriodStart   DateTime?
  statementPeriodEnd     DateTime?
  /// Dedup key — unique per user, not globally. Two different users legitimately
  /// holding the same statement (a joint account, or an identical UAT sample PDF)
  /// must each be able to upload it; a global unique index rejected the second
  /// person with a 409 naming a statement id belonging to an account they can't
  /// see. See "Known Bugs" in CLAUDE.md — this was already documented and is now
  /// fixed rather than merely noted.
  contentHash            String
  keyMapping             Json?
  extractedData          StatementExtractedData?
  totalTransactions      Int?
  exceptionCount         Int?
  /// Rows read straight out of the PDF, before normalisation drops any. This is
  /// what the extraction receipt shows at the gate — `totalTransactions` only
  /// lands at the end of the normalizer subgraph, long after the user has decided.
  rawRowCount            Int?
  /// Which extraction path ran. Not cosmetic: the image path carries its rows in
  /// graph state and skips the key mapper, so phase 2 has to know to reload them.
  isImageBased           Boolean                  @default(false)
  extractionStatus       String                   @default("Processing") // "Processing" | "Completed" | "Error"
  normalizerStatus       String                   @default("Not Started") // "Not Started" | "Processing" | "Completed" | "Error"
  categorizationStatus   String                   @default("Not Started") // "Not Started" | "Processing" | "Completed" | "Error"
  insightsStatus         String                   @default("Not Started") // "Not Started" | "Processing" | "Completed" | "Error"
  /// The user's current answer at the gate. Denormalised from the latest
  /// `StatementGateDecision` so "how many are waiting" is one indexed query.
  gateDecision           String                   @default("pending") // "pending" | "approved" | "declined"
  gateDecisions          StatementGateDecision[]
  extractionError        String?
  normalizerError        String?
  insightsError          String?
  transactions           FinalTransactionData[]
  normalizedTransactions NormalizedTransactions[] @relation("NormalizedTransactionsMetadata")
  exceptionTransactions  ExceptionTransactions[]  @relation("ExceptionTransactionsMetadata")
  errorPdfExtracts       ErrorPdfExtract[]        @relation("ErrorPdfExtractMetadata")
  balanceGaps            Json[]
  balanceGapCount        Int?
  extractionConfidence   Float?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([userId, contentHash])
}
