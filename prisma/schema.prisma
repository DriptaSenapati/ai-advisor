model FinalTransactionData {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  date                DateTime
  description         String
  creditAmount        Float
  debitAmount         Float
  balance             Float
  clusterId           String?            @db.ObjectId
  cluster             Cluster?           @relation(fields: [clusterId], references: [id])
  descriptionVector   Float[]
  statementMetadataId String?            @db.ObjectId
  statementMetadata   StatementMetadata? @relation(fields: [statementMetadataId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Cluster {
  id                       String                 @id @default(auto()) @map("_id") @db.ObjectId
  transactions             FinalTransactionData[]
  clusterLength            Int
  bankName                 String?
  merchantName             String?
  payeeName                String?
  category                 String?
  confidence               Float?
  categorySupportRationale String?
  centroid                 String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model MonthlyStats {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  month             String
  totalIncome       Float
  totalExpenses     Float
  netSavings        Float
  savingsRate       Float
  closingBalance    Float
  totalRefunds      Float
  refundCount       Int
  categoryBreakdown Json[]
  topMerchants      Json[]
  weekdayVsWeekend  Json
  timeOfMonth       Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RecurringPattern {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  type                   String?   @default("debit") // "debit" | "credit"
  merchantName           String?
  payeeName              String?
  category               String?
  estimatedMonthlyAmount Float
  rangeMin               Float?    // credit only: Q1 - 0.5*IQR of monthly amounts
  rangeMax               Float?    // credit only: Q3 + 0.5*IQR of monthly amounts
  creditLabel            String?   // "salary" | "freelance" | "rental_income" | "investment_return" | "transfer_in" | "unknown"
  clusterKey             String?   // unnamed credit clusters: clusterId hex string
  frequency              String
  monthsDetected         Int
  cancellability         String?   // "cancellable" | "pausable" | "obligation" | "essential"
  isActive               Boolean
  lastTransactionDate    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([merchantName, payeeName, estimatedMonthlyAmount, type])
}

model InsightReport {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String?
  generatedAt      DateTime @default(now())
  monthsCovered    String[]
  tier             Int
  insights         Json
  rawStatsSnapshot Json
  chartData        Json?
  createdAt        DateTime @default(now())
}

model Goal {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String
  goalType         String
  targetAmount     Float
  deadline         DateTime
  categoryTarget   String?
  status           String   @default("active")
  simulationResult Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StatementExtractedData {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  statementMetadataId String            @unique @db.ObjectId
  statementMetadata   StatementMetadata @relation(fields: [statementMetadataId], references: [id])
  rows                Json[]
  createdAt           DateTime          @default(now())
}

model ErrorPdfExtract {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  action              String
  rationale           String
  row                 Json
  statementMetadataId String?            @db.ObjectId
  statementMetadata   StatementMetadata? @relation("ErrorPdfExtractMetadata", fields: [statementMetadataId], references: [id])
  createdAt           DateTime           @default(now())
}

// Better Auth models — use plain string IDs (Better Auth generates its own non-ObjectId IDs)
model User {
  id            String    @id @map("_id")
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model StatementMetadata {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String?
  bankName               String
  accountNumber          String?
  statementPeriodStart   DateTime?
  statementPeriodEnd     DateTime?
  contentHash            String                   @unique
  keyMapping             Json?
  extractedData          StatementExtractedData?
  totalTransactions      Int?
  exceptionCount         Int?
  normalizerStatus       String                   @default("Processing") // "Processing" | "Completed" | "Error"
  categorizationStatus   String                   @default("Not Started") // "Not Started" | "Processing" | "Completed" | "Error"
  insightsStatus         String                   @default("Not Started") // "Not Started" | "Processing" | "Completed" | "Error"
  normalizerError        String?
  insightsError          String?
  transactions           FinalTransactionData[]
  normalizedTransactions NormalizedTransactions[] @relation("NormalizedTransactionsMetadata")
  exceptionTransactions  ExceptionTransactions[]  @relation("ExceptionTransactionsMetadata")
  errorPdfExtracts       ErrorPdfExtract[]        @relation("ErrorPdfExtractMetadata")
  balanceGaps            Json[]
  balanceGapCount        Int?
  extractionConfidence   Float?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}
